# Required
BLOB_READ_WRITE_TOKEN=           # Vercel Blob read/write token
ADMIN_KEY=                       # Secret key for POST /api/admin/data (used by push-data.sh)
SESSION_SECRET=                  # Random string for signing session cookies
CONTROL_ACCESS_TOKEN=            # Long random token — your private link is /<this-value>

# Optional: webhook (connect the page buttons to your bot)
WEBHOOK_URL=                     # Your bot's webhook endpoint URL
WEBHOOK_KEY=                     # Sender key for the webhook
WEBHOOK_KEY_HEADER=Authorization # Header name for the key (default: Authorization)

# Optional: display
NEXT_PUBLIC_TIMEZONE=            # IANA timezone, e.g. America/New_York (default: viewer's TZ)
